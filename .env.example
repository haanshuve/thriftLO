# =============================================================================
# thriftLO - contoh konfigurasi environment
# Lokal  : salin ke .env, lalu jalankan `php artisan key:generate`
# Railway: isi variabel yang sama di tab Variables (lihat catatan "PRODUCTION")
# =============================================================================

APP_NAME=thriftLO
# PRODUCTION: production
APP_ENV=local
# Wajib. Lokal: php artisan key:generate. Railway: hasil `php artisan key:generate --show`
APP_KEY=
# PRODUCTION: false (jangan tampilkan detail error ke pengunjung)
APP_DEBUG=true
# PRODUCTION: URL publik tanpa garis miring di akhir, mis. https://thriftlo-production.up.railway.app
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# PRODUCTION: LOG_CHANNEL=stderr supaya log muncul di tab Logs Railway
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: error
LOG_LEVEL=debug

# Database MySQL (XAMPP lokal). Di Railway cukup isi DB_CONNECTION=mysql dan
# DB_URL=${{MySQL.MYSQL_URL}}; DB_URL mengalahkan DB_HOST/DB_PORT/dst.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thriftlo_db
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=

# Session disimpan di file (tabel sessions tidak dibuat oleh migrasi project ini)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION (HTTPS): true
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Upload disimpan di storage/app (private: KTP & selfie, public: foto produk).
# Di Railway pasang Volume ke folder storage/app supaya file tidak hilang saat redeploy.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (reset kata sandi). "log" = email hanya ditulis ke log, tidak benar-benar terkirim.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@thriftlo.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Login dengan Google (Google Cloud Console > APIs & Services > Credentials)
# Redirect URI harus SAMA PERSIS dengan yang didaftarkan di Google Cloud Console.
# Lokal  : http://127.0.0.1:8000/auth/google/callback
# Railway: https://<domain-railway>/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Langganan penjual (Rp5.000/bulan). true = tombol "Bayar Sekarang" langsung
# mengaktifkan langganan tanpa payment gateway. Kalau tidak diisi: aktif di
# lokal, MATI saat APP_ENV=production. Untuk demo di Railway isi true.
# -----------------------------------------------------------------------------
SUBSCRIPTION_SIMULATION=true
